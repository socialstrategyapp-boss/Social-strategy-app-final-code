# Database
DATABASE_URL=postgresql://payai:password@localhost:5432/payai_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# XRPL
XRPL_NETWORK=wss://s.altnet.rippletest.net:51233
XRPL_ISSUER_SEED=your-xrpl-testnet-issuer-seed
XRPL_ISSUER_ADDRESS=your-xrpl-testnet-issuer-address

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+61400000000

# KYC (Frankie One - sandbox)
FRANKIE_API_KEY=your-frankieone-sandbox-key
FRANKIE_CUSTOMER_ID=your-frankieone-customer-id

# Server
PORT=3001
NODE_ENV=development

# Float Pool
FLOAT_POOL_ACTIVE_BUCKET=20000
FLOAT_POOL_RELOAD_TRIGGER=5000
FLOAT_POOL_RELOAD_AMOUNT=15000
REVENUE_TOP_UP_PERCENT=20
PAI_BURN_PERCENT=1
